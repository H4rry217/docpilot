<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <springProperty scope="context" name="ROOT_LOG_LEVEL" source="logging.level.root" defaultValue="INFO"/>
    <springProperty scope="context" name="DOCPILOT_LOG_LEVEL" source="logging.level.io.docpilot" defaultValue="INFO"/>
    <springProperty scope="context" name="FILESYSTEM_LOG_LEVEL" source="logging.level.io.docpilot.filesystem" defaultValue="${DOCPILOT_LOG_LEVEL}"/>
    <springProperty scope="context" name="WORKSPACE_FILESYSTEM_LOG_LEVEL" source="logging.level.io.docpilot.workspace.filesystem" defaultValue="${DOCPILOT_LOG_LEVEL}"/>
    <springProperty scope="context" name="LOG_DIR" source="logging.file.path" defaultValue="./logs"/>

    <property name="LOG_CHARSET" value="UTF-8"/>
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} - usr=[%X{user}],trace=[%X{traceId}][%thread] %-5level %logger{40} - [%method,%line] - %msg%n"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>${LOG_CHARSET}</charset>
        </encoder>
    </appender>

    <appender name="FILE_FOR_INFO" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>${LOG_CHARSET}</charset>
        </encoder>
        <file>${LOG_DIR}/app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/app/%d{yyyy-MM-dd}/%d{yyyy-MM-dd_HH}.%i.log.gz</fileNamePattern>
            <maxFileSize>30MB</maxFileSize>
        </rollingPolicy>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>DEBUG</level>
        </filter>
    </appender>

    <appender name="FILE_FOR_WRN" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>${LOG_CHARSET}</charset>
        </encoder>
        <file>${LOG_DIR}/warn.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/warn/%d{yyyy-MM-dd}/%d{yyyy-MM-dd_HH}.%i.log.gz</fileNamePattern>
            <maxFileSize>30MB</maxFileSize>
        </rollingPolicy>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>WARN</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
    </appender>

    <appender name="FILE_FOR_ERR" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>${LOG_CHARSET}</charset>
        </encoder>
        <file>${LOG_DIR}/error.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/error/%d{yyyy-MM-dd}/%d{yyyy-MM-dd_HH}.%i.log.gz</fileNamePattern>
            <maxFileSize>30MB</maxFileSize>
        </rollingPolicy>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
    </appender>

    <appender name="FILE_INFO_ASYNC" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>8192</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <appender-ref ref="FILE_FOR_INFO"/>
    </appender>

    <appender name="FILE_WRN_ASYNC" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>8192</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <appender-ref ref="FILE_FOR_WRN"/>
    </appender>

    <appender name="FILE_ERR_ASYNC" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>8192</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <appender-ref ref="FILE_FOR_ERR"/>
    </appender>

    <root level="${ROOT_LOG_LEVEL}">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="FILE_INFO_ASYNC"/>
        <appender-ref ref="FILE_WRN_ASYNC"/>
        <appender-ref ref="FILE_ERR_ASYNC"/>
    </root>

    <logger name="ch.qos.logback" level="WARN"/>
    <logger name="org.springframework" level="INFO"/>
    <logger name="io.docpilot" level="${DOCPILOT_LOG_LEVEL}"/>
    <logger name="io.docpilot.filesystem" level="${FILESYSTEM_LOG_LEVEL}"/>
    <logger name="io.docpilot.workspace.filesystem" level="${WORKSPACE_FILESYSTEM_LOG_LEVEL}"/>

</configuration>
